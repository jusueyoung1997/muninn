---
import '../styles/global.css';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A personal knowledge base.' } = Astro.props;

const navItems = [
  { href: withBase(''), label: 'Home' },
  { href: withBase('notes/'), label: 'Notes' },
  { href: withBase('tags/'), label: 'Tags' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{title} · muninn</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav container">
        <a class="brand" href={withBase('')}>muninn</a>
        <ul class="nav-links">
          {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer container">
      <p>A personal knowledge base · built with <a href="https://astro.build">Astro</a></p>
    </footer>
  </body>
</html>
