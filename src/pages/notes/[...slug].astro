---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import 'katex/dist/katex.min.css';
import { withBase } from '../../utils/url';
import { formatDate } from '../../utils/notes';
export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.draft !== true);
  return notes.map(note => ({ params: { slug: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content, headings } = await render(note);
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout title={note.data.title} description={note.data.description}>
  <div class="article-layout">
    <article class="article-main">
      <header class="article-header">
        <a class="back-link" href={withBase('notes/')}>← 返回文章归档</a>
        <div class="article-meta mono"><time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>{note.data.updated && <span>更新于 {formatDate(note.data.updated)}</span>}</div>
        <h1>{note.data.title}</h1>
        {note.data.description && <p class="article-description">{note.data.description}</p>}
        <div class="tags">{note.data.tags.map(tag => <a class="tag" href={withBase(`tags/${encodeURIComponent(tag)}/`)}>{tag}</a>)}</div>
      </header>
      {toc.length > 0 && <details class="mobile-toc"><summary class="eyebrow">ON THIS PAGE <span>展开文章目录</span></summary><nav aria-label="文章目录"><ol>{toc.map(heading => <li class:list={{ 'toc-sub': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></details>}
      <div class="note-body"><Content /></div>
      <footer class="article-end"><span class="mono">END OF NOTE</span><a href={withBase('notes/')}>继续阅读其他文章 →</a></footer>
    </article>
    {toc.length > 0 && <aside class="article-toc"><details open><summary class="eyebrow">ON THIS PAGE <span>目录</span></summary><nav aria-label="文章目录"><ol>{toc.map(heading => <li class:list={{ 'toc-sub': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></details></aside>}
  </div>
</BaseLayout>
