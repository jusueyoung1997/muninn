---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/url';
const notes = await getCollection('notes', ({ data }) => data.draft !== true);
const tagCounts = new Map<string, number>();
for (const note of notes) for (const tag of note.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---
<BaseLayout title="探索主题" description="沿着一个主题，发现更多相互关联的笔记。">
  <header class="page-intro"><p class="eyebrow">THE INDEX / {String(tags.length).padStart(2, '0')} TOPICS</p><h1>沿着好奇心，探索<span class="accent">.</span></h1><p>从一个关键词开始，找到想读的下一篇。</p></header>
  <div class="topic-grid">{tags.map(([tag, count]) => <a href={withBase(`tags/${encodeURIComponent(tag)}/`)}><span class="hash mono">#</span><h2>{tag}</h2><span class="topic-count">{count} 篇笔记 <span aria-hidden="true">↗</span></span></a>)}</div>
</BaseLayout>
